@model SalesHelper.Models.InterfaceModels.AddCustomerInterface
<style>
    .select2-selection {
        border-radius: 0px !important;
    }
</style>
<div class="content-overlay"></div>
<div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">

            <h3 class="content-header-title mb-0">New Customer</h3>

        </div>
    </div>
    <div class="content-body">
        <!-- New customer section start -->
        <section id="basic-form-layouts">
            <div class="row match-height">
                <div class="col-md-12">
                    <div class="card AddCustomerCard">
                        @*  <div class="card-header">
                        <h4 class="form-section"><i class="feather icon-user"></i> Customer Info</h4>
                        </div> *@
                        <div class="card-content collapse show">
                            <div class="card-body">
                                <form class="form" asp-controller="Customers" asp-action="AddCustomers" method="post">
                                    <div class="form-body">

                                        <div class="row">
                                            <div class="col-md-6">

                                                <h4 class="form-section"><i class="feather icon-user"></i> Customer Info</h4>

                                                <div class="form-group">
                                                    <label>First Name <span class="required">*</span></label>
                                                    <input asp-for="Customer.FirstName" type="text" class="form-control form-control-sm square" placeholder="First Name" required>
                                                </div>

                                                <div class="form-group">
                                                    <label>Last Name</label>
                                                    <input asp-for="Customer.LastName" type="text" class="form-control form-control-sm square" placeholder="Last Name">
                                                </div>

                                                <div class="form-group">
                                                    <label>Email</label>
                                                    <input asp-for="Customer.Email" type="email" class="form-control form-control-sm square" placeholder="Email">
                                                </div>

                                                <div class="form-group">
                                                    <label>Cell Phone <span class="required">*</span></label>
                                                    <input asp-for="Customer.CellPhone" type="text" class="form-control form-control-sm square" placeholder="Cell Phone" required>
                                                </div>

                                                <div class="form-group">
                                                    <label>Home Phone</label>
                                                    <input asp-for="Customer.HomePhone" type="text" class="form-control form-control-sm square" placeholder="Home Phone">
                                                </div>

                                                <div class="form-group">
                                                    <label>Work Phone</label>
                                                    <input asp-for="Customer.WorkPhone" type="text" class="form-control form-control-sm square" placeholder="Work Phone">
                                                </div>

                                                <div class="form-group">
                                                    <label>Company</label>
                                                    <input asp-for="Customer.Company" type="text" class="form-control form-control-sm square" placeholder="Company">
                                                </div>
                                            </div>
                                            <div class="col-md-6">

                                                <h4 class="form-section"><i class="feather icon-home"></i> Customer Address Info</h4>

                                                <div class="form-group">
                                                    <label>Address Line 1</label>
                                                    <input asp-for="Address.Address1" class="form-control form-control-sm square" type="text" placeholder="Address line 1">
                                                </div>
                                                <div class="form-group">
                                                    <label>Address Line 2</label>
                                                    <input asp-for="Address.Address2" class="form-control form-control-sm square" type="text" placeholder="Address line 2">
                                                </div>
                                                <div class="form-group">
                                                    <label>Country</label>
                                                    <select asp-for="Address.Country" class="form-control square">
                                                        <option value="">Select a country</option>
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label>State</label>
                                                    <select asp-for="Address.State" class="form-control square" placeholder="state">
                                                        <option value="">Select a state</option>
                                                    </select>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label>City</label>
                                                            <input asp-for="Address.City" class="form-control form-control-sm square" type="text" placeholder="City">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label>Postal Code / Zip</label>
                                                            <input asp-for="Address.PostalCode" type="text" class="form-control form-control-sm square" placeholder="Postal Code / Zip">
                                                        </div>
                                                    </div>
                                                </div>
                                                <input asp-for="Address.AddressType" value="home" hidden />

                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <button type="reset" class="btn btn-warning"><i class="feather icon-x"></i> Cancel</button>
                                            <button type="submit" class="btn btn-primary"><i class="fa fa-check-square-o"></i> Save</button>
                                        </div>

                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </section>
        <!-- // New customer section end -->
    </div>
</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {
        function setupAutocomplete(inputId, cardId, addressPrefix) {
            var searchInput = document.getElementById(inputId);
            var autocomplete = new google.maps.places.Autocomplete(searchInput);
            autocomplete.setFields(["address_components", "formatted_address"]);
            autocomplete.addListener("place_changed", function () {
                var place = autocomplete.getPlace();
                var address = place.formatted_address;

                var blockui = ShowBlockUi(cardId, "Loading Address Details...");
                // setting address1, city, state & postalcode, country in the address fields
                var addressArray = address.split(",");

                var address1 = addressArray[0].trim();
                var city = addressArray[1].trim();
                var state = addressArray[2].trim().split(" ")[0];
                var postalCode = addressArray[2].trim().split(" ")[1];
                var country = addressArray[3].trim();

                $("#" + addressPrefix + "Address1").val(address1);
                $("#" + addressPrefix + "Country").val(country).trigger("change");
                // wait for states to be populated before setting the state
                var stateSetInterval = setInterval(function () {
                    debugger;
                    if ($("#" + addressPrefix + "State option").length > 0) {
                        $("#" + addressPrefix + "State").val(state).trigger("change");
                        clearInterval(stateSetInterval);
                        // Unblock the UI after setting the state
                        $(blockui).unblock();
                    }
                }, 100);
                $("#" + addressPrefix + "City").val(city);
                $("#" + addressPrefix + "PostalCode").val(postalCode);
            });
        }

        setupAutocomplete("Address_Address1", "AddCustomerCard", "Address_");
    });


    $(document).ready(function () {

        // Apply input mask to phone number fields
        $("#Customer_CellPhone, #Customer_HomePhone, #Customer_WorkPhone").inputmask({
            mask: '999-999-9999',
            placeholder: '___-___-____'
        });

        // loading countries from api endpoint
        $.ajax({
            url: 'https://countriesnow.space/api/v0.1/countries/states',
            method: 'GET',
            success: function (data) {
                let countries = data.data.map(country => ({
                    id: country.iso3,
                    text: country.name
                }));
                $('#Address_Country').select2({
                    data: countries
                });
                $('#Address_Country').val('USA').trigger('change');
            },
            error: function (error) {
                alert('Error fetching countries:', error);
            }
        });

        // on selecting country get states using ajax request
        $('#Address_Country').on('change', function () {
            // show block ui
            var blockui = ShowBlockUi("AddCustomerCard", "Loading States...");
            $('#Address_State').empty();
            var country = $('#Address_Country option:selected').text();
            $.ajax({
                url: 'https://countriesnow.space/api/v0.1/countries/states',
                method: 'POST',
                data: { "country": country },
                success: function (data) {
                    let states = data.data.states.map(state => ({
                        id: state.state_code,
                        text: state.name
                    }));
                    $('#Address_State').select2({
                        data: states
                    });
                    // hide block ui
                    // Unblock the UI after setting the state
                    $(blockui).unblock();
                },
                error: function (error) {
                    alert('Error fetching states:', error);
                }
            });
        });
    });
</script>