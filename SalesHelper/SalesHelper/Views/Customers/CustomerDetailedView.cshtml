                            <li class="nav-item">
                                <a class="nav-link d-flex" id="customer-info-link" data-toggle="pill" href="#customer-info-section" aria-expanded="true">
                                    <i class="ti-user"></i>
                                    Customer Information
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex" id="quotes-info-link" data-toggle="pill" href="#quotes-info-section" aria-expanded="false">
