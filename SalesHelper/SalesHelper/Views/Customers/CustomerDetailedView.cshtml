@using SalesHelper.Models.InterfaceModels
@{
    int customerId = ViewBag.CustomerId;
    List<CustomerEmailInterface>? customerEmails = ViewBag.CustomerEmails;
}

<style>
    tr td:first-child {
        font-weight: bold;
        width: 40%;
        padding-left: 0;
        padding-right: 0;
    }

    .AvatarMedia {
        align-items: center;
    }
</style>

<div class="content-overlay"></div>
<div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title mt-1">Customer Details</h3>
        </div>
        <div class="content-header-right col-md-6 col-12">
            <div class="btn-group float-md-right" role="group">
                <div class="btn-group mr-1 mb-1">
                    <button style="border-bottom-right-radius: 0px;border-top-right-radius: 0px;"
                            type="button" class="btn btn-outline-primary btn-min-width dropdown-toggle" data-toggle="dropdown">
                        <i class="ti-pencil-alt mr-1"></i>New Quote
                    </button>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" asp-controller="Quotations" asp-action="CreateCabinetQuotation" asp-route-customerId="@customerId">Cabinet Quote</a>
                        <a class="dropdown-item" asp-controller="Quotations" asp-action="CreateCountertopQuotationView" asp-route-customerId="@customerId">Countertop Quote</a>
                        <a class="dropdown-item" href="#">Hardware Quote</a>
                        <a class="dropdown-item" href="#">Other Quote</a>
                    </div>
                    <a class="btn btn-outline-primary" asp-action="CalendarView" asp-controller="Events"><i class="fa fa-calendar mr-1"></i>New Event</a>
                    <a class="btn btn-outline-primary" href="#"><i class="feather icon-check-square mr-1"></i>New Task</a>
                </div>
            </div>
        </div>
    </div>
    <div class="sidebar-detached sidebar-left ps">
        <div class="sidebar">
            <div class="bug-list-sidebar-content">
                <!-- Predefined Views -->
                <div class="card">
                    <div class="card-head">
