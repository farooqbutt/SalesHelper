@if (User.Identity!.IsAuthenticated)
{
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-header row">
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-lg-4 col-12">
                    <div class="card border-0">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="media d-flex">
                                    <div class="media-body">
                                        <h1 class="font-large-2">@ViewData["totalCustomers"]</h1>
                                        <span class="text-muted">Total Customers</span>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="feather icon-users blue-grey font-large-2 lighten-3"></i>
                                    </div>
                                </div>
                                <div class="mt-2 d-flex justify-content-between">
                                    <a href="/Customers/CustomerListView">View Customers <i class="feather icon-arrow-right"></i></a>
                                    <a href="/Customers/AddCustomers">Add Customer <i class="feather icon-plus"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-12">
                    <div class="card border-0">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="media d-flex">
                                    <div class="media-body">
                                        <h1 class="font-large-2">@ViewData["totalQuotations"]</h1>
                                        <span class="text-muted">Total Quotes</span>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="feather icon-file-text blue-grey font-large-2 lighten-3"></i>
                                    </div>
                                </div>
                                <div class="mt-2 d-flex justify-content-between">
                                    <a href="/Customers/CustomerListView">View Quotes <i class="feather icon-arrow-right"></i></a>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-icon btn-pure text-primary dropdown-toggle p-0" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Add Quote</button>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="/Quotations/CreateCabinetQuotation">Cabinet Quote</a>
                                            <a class="dropdown-item" href="/Quotations/CreateCountertopQuotationView">Countertop Quote</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-12">
                    <div class="card border-0">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="media d-flex">
                                    <div class="media-body">
                                        <h1 class="font-large-2">@ViewData["totalSales"]</h1>
                                        <span class="text-muted">Total Sales</span>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="feather icon-bar-chart blue-grey font-large-2 lighten-3"></i>
                                    </div>
                                </div>
                                <div class="mt-2 d-flex justify-content-between">
                                    <a href="/Sales/SalesList">View Sales <i class="feather icon-arrow-right"></i></a>
                                    <a href="/Sales/CreateSales">Add Sale <i class="feather icon-plus"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="p-5 text-center bg-body-tertiary rounded-3">
        <img src="~/images/logo/SalesHelperLogo.png" height="100" width="100" />
        <h1 class="text-body-emphasis">Welcome to SalesHelper!</h1>
        <h5 class="col-lg-8 mx-auto fs-5 text-muted">
            The all-in-one solution for cabinetry owners to manage customers, quotations, sales orders, and budget calculations.
        </h5>
        <div class="d-inline-flex gap-2 mb-5">
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg mr-2">
                Register With Us Now!
            </a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg">
                Login Here
            </a>
        </div>
        <h3 class="text-center text-primary">Register with SalesHelper to get your Cabinetry to Next Level!</h3>
    </div>

    <div class="container features">
        <div class="row">
            <div class="col-md-4 feature-item">
                <h2 class="feature-title">Customer Management</h2>
                <p class="feature-description">Easily manage your customers with our intuitive interface.</p>
            </div>
            <div class="col-md-4 feature-item">
                <h2 class="feature-title">Quotations and Sales Orders</h2>
                <p class="feature-description">Create and manage quotations and sales orders with just a few clicks.</p>
            </div>
            <div class="col-md-4 feature-item">
                <h2 class="feature-title">Budget Calculations</h2>
                <p class="feature-description">Quickly and accurately calculate budgets for your projects.</p>
            </div>
        </div>
    </div>
}