
<div class="content-overlay"></div>
<div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title mb-0">All Purchase Orders</h3>
        </div>
        <div class="content-header-right col-md-6 col-12 mb-md-0 mb-2">
            <span class="dropdown">
                <button id="btnQuote" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true"
                        class="btn btn-primary dropdown-menu-right dropdown-toggle btn-md float-right">
                    <i class="fa fa-plus"></i> New Order
                </button>
                <span aria-labelledby="btnQuote" class="dropdown-menu dropdown-menu-right mt-1">
                    <a asp-controller="PurchaseOrders" asp-action="CreateCabinetDraftOrder" class="dropdown-item">Cabinet Order</a>
                    <a asp-controller="PurchaseOrders" asp-action="" class="dropdown-item">Countertop Order</a>
                    <a asp-controller="PurchaseOrders" asp-action="" class="dropdown-item">Hardware Order</a>
                    <a asp-controller="PurchaseOrders" asp-action="" class="dropdown-item">Installation Order</a>
                </span>
            </span>
        </div>
    </div>
    <div class="content-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-content collpase show">
                        <div class="card-body card-dashboard">
                            <table id="AllOrdersList" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>PO #</th>
                                        <th>Sale #</th>
                                        <th>Customer</th>
                                        <th>Vendor</th>
                                        <th>Order Name</th>
                                        <th>Order Type</th>
                                        <th>Order #</th>
                                        <th>Date Created</th>
                                        <th>Status</th>
                                        <th>Shipping Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Get All Orders
        $('#AllOrdersList').DataTable({
            "ajax": {
                "url": "/PurchaseOrders/GetAllOrders",
                "type": "GET",
                "dataType": "json",
                "dataSrc": "data"
            },
            "columns": [
                { "data": "purchaseOrderNumber" },
                {
                    "data": null,
                    "render": function(data, type, row){
                        if (row.salesOrderId) {
                            return row.salesOrderId
                        } else {
                            return 'N/A';
                        }
                    }
                },
                {
                    "data": null,
                    "render": function (data, type, row) {
                        return `
                                    <a href="/Customers/CustomerDetailedView/${row.customerFK.id}">
                                        ${row.customerFK.firstName}
                                        ${row.customerFK.lastName ? row.customerFK.lastName : ''}
                                    </a>
                                    `;
                    }
                },
                { "data": "vendorFK.companyName" },
                { "data": "orderName" },
                { "data": "orderTypeForSalesHelper" },
                {
                    "data": null,
                    "render": function (data, type, row) {
                        if (row.orderNumberByVendor) {
                            return row.orderNumberByVendor;
                        } else {
                            return `
                                <div class="d-flex flex-row">
                                    <input class="form-control form-control-sm square" id="OrderNumberByVendor_${row.id}" style="width:120px;height:22px;" />
                                    <button onclick="SaveOrderNumberByVendor('OrderNumberByVendor_${row.id}')" class="btn btn-primary btn-sm"><i class="feather icon-check"></i></button>
                                </div>
                            `;
                        }
                    }
                },
                {
                    "data": null,
                    "render": function (data, type, row) {
                        return moment(row.orderDate).format('MM/DD/YYYY');
                    }
                },
                {
                    "data": null,
                    "render": function (data, type, row) {
                        return `
                            <select class="form-control form-control-sm">
                                <option value="Created">Created</option>
                                <option value="Inprocessing">Inprocessing</option>
                                <option value="Shipped">Shipped</option>
                                <option value="Completed">Completed</option>
                            </select>
                        `;
                    }
                },
                {
                    "data": null,
                    "render": function (data, type, row) {
                        if (row.shippingDate) {
                            return moment(row.shippingDate).format('MM/DD/YYYY');
                        } else {
                            return `
                                <div class="d-flex flex-row">
                                    <input type="date" class="form-control form-control-sm square" style="width:120px;height:22px;" />
                                    <button class="btn btn-primary btn-sm"><i class="feather icon-check"></i></button>
                                </div>
                            `;
                        }
                    }
                },
                {
                    "data": null,
                    "render": function (data, type, row) {
                        return `
                                <span class="dropdown">
                                    <a data-toggle="dropdown" class="dropdown-toggle dropdown-menu-right"><i class="fa fa-ellipsis-v"></i></a>
                                    <span class="dropdown-menu mt-1 dropdown-menu-right" x-placement="bottom-end">
                                        <a class="dropdown-item edit"><i class="feather icon-edit-2"></i>Edit</a>
                                        <a class="dropdown-item"><i class="feather icon-refresh-cw primary"></i> Convert to Purchase Order</a>
                                    </span>
                                </span>
                        `;
                    }
                }
            ]
        });
    });

    function SaveOrderNumberByVendor (inputId) {
        var orderno = $('#' + inputId).val();
        var id = inputId.split('_')[1];
    }
</script>