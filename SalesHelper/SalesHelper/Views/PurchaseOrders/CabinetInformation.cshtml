@using Microsoft.AspNetCore.Identity
@inject SalesHelper.Services.CustomerService _customerService
@inject SalesHelper.Services.VendorService _vendorService
@inject SignInManager<ApplicationUser> _signInManager

@{
    var customersList = _customerService.ReadAll().Where(a => a.CreatedByUserId == _signInManager.UserManager.GetUserAsync(User).Result.Id);
}

<style>
    .select2-selection {
        border-radius: 0px !important;
    }

    .form-group {
        margin-bottom: 0.8rem; /* Reducing the spacing */
    }

    #cabinetDetailsTable {
        border: 1px solid #ccd6e6;
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        border: 1px solid #ccd6e6;
        padding: 8px;
    }

    .radio-label {
        margin-right: 20px;
    }

    .btn-space {
        margin-right: 8px;
    }

    .mandatory select {
        background-color: #fff7a1 !important; /* Light yellow color for mandatory fields */
    }

    /* Add dropdown icon for select elements */
    .form-control {
        background: url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjMiIGhlaWdodD0iMTMiIHZpZXdCb3g9IjAgMCAyMyAxMyIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDEvMTIvMjAxMSIvPjxwYXRoIGQ9Ik01LjUsNy4yNUwyMywyMywxMyw1LjUsOS43NVoiIGZpbGw9IiM2NjYiLz48L3N2ZyBzdHJva2U9InByZWdsaXNoIiBzdHJva2Utd2lkdGg9IjEuNSIvPg==') no-repeat right 10px center;
        background-size: 12px;
        padding-right: 30px;
    }

    /* Style for select2 dropdowns */
    .select2-container--default .select2-selection--single {
        background: url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjMiIGhlaWdodD0iMTMiIHZpZXdCb3g9IjAgMCAyMyAxMyIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDEvMTIvMjAxMSIvPjxwYXRoIGQ9Ik01LjUsNy4yNUwyMywyMywxMyw1LjUsOS43NVoiIGZpbGw9IiM2NjYiLz48L3N2ZyBzdHJva2U9InByZWdsaXNoIiBzdHJva2Utd2lkdGg9IjEuNSIvPg==') no-repeat right 10px center;
        background-size: 12px;
    }
</style>

<script>
    $(document).ready(function () {
        // Ensure Frame Option & Hinge Type are always visible
        $('#frameOptionField').show();
        $('#hingeTypeField').show();

        // Show/hide fields based on Cabinet Line selection
        $('input[name="cabinetLine"]').change(function () {
            if ($(this).val() === 'Insert') {
                $('#frameOptionField').show();
                $('#hingeTypeField').show();
                $('#hingeType').val('Concealed'); // Set Hinge Type to Concealed
            } else if ($(this).val() === 'Overlay') {
                $('#frameOptionField').hide();
                $('#hingeTypeField').show();
                $('#hingeType').val('Softclose'); // Set Hinge Type to Softclose
            }
        });

        // Enable Select2 for dropdowns
        $('.form-control').select2({
            tags: true
        });
    });
</script>

<div class="content-overlay"></div>
<div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title mb-0">Cabinet Information</h3>
        </div>
    </div>
    <div class="content-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-content collpase show">
                        <div class="card-body card-dashboard">
                            <form method="post">
                                <div class="form-group">
                                    <label>Maker <span class="text-danger">*</span></label><br />
                                    <label class="radio-label">
                                        <input type="radio" name="maker" value="Starmark" required> Starmark
                                    </label>
                                    <label class="radio-label">
                                        <input type="radio" name="maker" value="Other" required> Other
                                    </label>
                                </div>

                                <div class="form-group">
                                    <label>Cabinet Line <span class="text-danger">*</span></label><br />
                                    <label class="radio-label">
                                        <input type="radio" name="cabinetLine" value="Overlay" required> Overlay
                                    </label>
                                    <label class="radio-label">
                                        <input type="radio" name="cabinetLine" value="Insert" required> Insert
                                    </label>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group mandatory">
                                            <label>Box Construction <span class="text-danger">*</span></label>
                                            <select id="boxConstruction" class="form-control">
                                                <option value="Framed Overlay">Framed Overlay</option>
                                                <option value="Frameless">Frameless</option>
                                                <option value="Inset">Inset</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mandatory">
                                            <label>Box Material <span class="text-danger">*</span></label>
                                            <select id="boxMaterial" class="form-control">
                                                <option value="Plywood 3/4">Plywood 3/4</option>
                                                <option value="Plywood 1/2">Plywood 1/2</option>
                                                <option value="Standard Interiors">Standard Interiors</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mandatory">
                                            <label>Door Design Style <span class="text-danger">*</span></label>
                                            <select id="doorDesignStyle" class="form-control">
                                                <option value="Style">Style</option>
                                                <option value="Uppers">Uppers</option>
                                                <option value="Lowers">Lowers</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group mandatory">
                                            <label>Door Material <span class="text-danger">*</span></label>
                                            <select id="doorMaterial" class="form-control">
                                                <option value="Mel/Laminate">Mel/Laminate</option>
                                                <option value="Thermo foil">Thermo foil</option>
                                                <option value="Painted">Painted</option>
                                                <option value="Oak">Oak</option>
                                                <option value="Maple">Maple</option>
                                                <option value="Cherry">Cherry</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mandatory">
                                            <label>Drawer Head <span class="text-danger">*</span></label>
                                            <select id="drawerHead" class="form-control">
                                                <option value="5-PC">5-PC</option>
                                                <option value="Scooped Profile Head">Scooped Profile Head</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4" id="hingeTypeField">
                                        <div class="form-group">
                                            <label>Hinge Type</label>
                                            <select id="hingeType" class="form-control">
                                                <option value="Concealed">Concealed</option>
                                                <option value="Softclose">Softclose</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4" id="frameOptionField">
                                        <div class="form-group">
                                            <label>Frame Option (Inset only)</label>
                                            <select id="frameOption" class="form-control">
                                                <option value="Flush Frame">Flush Frame</option>
                                                <option value="Beaded Frame">Beaded Frame</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4"></div>
                                </div>

                                <div class="mb-2">
                                    <button type="reset" class="btn btn-warning btn-space"><i class="feather icon-arrow-left"></i> Back</button>
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-check-square-o"></i> Save & Submit</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
