@model SalesHelper.Models.PurchaseOrder
@inject SalesHelper.Services.UserServices.AccountService _accountService

<div class="content-overlay"></div>
<div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title mb-0">Purchase Order Details</h3>
        </div>
    </div>
    <div class="content-body">
        <section class="app-invoice-wrapper">
            <div class="row">
                <div class="col-xl-9 col-md-8 col-12 printable-content">
                    <!-- using a bootstrap card -->
                    <div class="card">
                        <!-- card body -->
                        <div class="card-body p-2">
                            <!-- card-header -->
                            <div class="card-header px-0">
                                <div class="row mb-50">
                                    @if (Model.PurchaseOrderNumber != null) 
                                    {
                                        <div class="col-md-3">
                                            <span class="invoice-id font-weight-bold">PO # </span>
                                            <span>@Model.PurchaseOrderNumber</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-3">
                                            <span class="invoice-id font-weight-bold">Draft # </span>
                                            <span>@Model.Id</span>
                                        </div>
                                    }
                                    <div class="col-md-3">
                                        <span class="invoice-id font-weight-bold">Cabinetry: </span>
                                        <span>@Model.VendorFK.CompanyName</span>
                                    </div>
                                    <div class="col-md-3">
                                        <span class="invoice-id font-weight-bold">Order Date: </span>
                                        <span>@Model.OrderDate.ToShortDateString()</span>
                                    </div>
                                    <div class="col-md-3">
                                        <span class="invoice-id font-weight-bold">Est. Shipping Date: </span>
                                        <span>@DateTime.Now.ToShortDateString()</span>
                                    </div>
                                </div>
                            </div>

                            <hr>

                            <!-- invoice address and contacts -->
                            <div class="row invoice-adress-info py-2">
                                <div class="col-4 mt-1 from-info">
                                    <div class="info-title mb-1">
                                        <span>Account Information</span>
                                    </div>
                                    <div class="company-name mb-1">
                                        <span class="invoice-id font-weight-bold">Account#: </span>
                                        <span class="text-muted">@_accountService.Read(Model.CustomerFK.AccountNumber).AccountNumber</span>
                                    </div>
                                    <div class="company-address mb-1">
                                        <span class="text-muted">
                                            @_accountService.Read(Model.CustomerFK.AccountNumber).BusinessAddress.Address1,
                                            @_accountService.Read(Model.CustomerFK.AccountNumber).BusinessAddress.Address2,
                                            @_accountService.Read(Model.CustomerFK.AccountNumber).BusinessAddress.City,
                                            @_accountService.Read(Model.CustomerFK.AccountNumber).BusinessAddress.State,
                                            @_accountService.Read(Model.CustomerFK.AccountNumber).BusinessAddress.Country,
                                            @_accountService.Read(Model.CustomerFK.AccountNumber).BusinessAddress.PostalCode
                                        </span>
                                    </div>
                                    <div class="company-email  mb-1 mb-1">
                                        <span class="text-muted">
                                            @_accountService.Read(Model.CustomerFK.AccountNumber).Email
                                        </span>
                                    </div>
                                    <div class="company-phone  mb-1">
                                        <span class="invoice-id font-weight-bold">Conatact #: </span>
                                        <span class="text-muted">
                                            @_accountService.Read(Model.CustomerFK.AccountNumber).PrimaryContactPhone
                                        </span>
                                    </div>
                                    @* <div class="company-name mb-1">
                                        <span class="invoice-id font-weight-bold">Brand: </span>
                                        <span>Wood-Mode</span>
                                    </div> *@
                                </div>
                                <div class="col-4 mt-1 to-info">
                                    <div class="info-title mb-1">
                                        <span>Shipping Information</span>
                                    </div>
                                    <div class="company-name mb-1">
                                        <span class="text-muted">@Model.ShippingContactName</span>
                                    </div>
                                    <div class="company-name mb-1">
                                        <span class="text-muted">@Model.ShippingAddress1</span>
                                    </div>
                                    <div class="company-address mb-1">
                                        <span class="text-muted">
                                            @Model.ShippingAddress2, @Model.ShippingCity, @Model.ShippingState, @Model.ShippingCountry, @Model.ShippingPostalCode
                                        </span>
                                    </div>
                                    <div class="company-phone  mb-1">
                                        <span class="text-muted">@Model.ShippingContactPhone</span>
                                    </div>
                                </div>
                                <div class="col-4 mt-1 to-info">
                                    <div class="info-title mb-1">
                                        <span>Order Information</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.CabinetLine))
                                    {
                                        <div class="company-address mb-1">
                                            <span class="invoice-id font-weight-bold">Cabinet Line: </span>
                                            <span class="text-muted">@Model.CabinetLine</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.BoxConstruction))
                                    {
                                        <div class="company-email mb-1">
                                            <span class="invoice-id font-weight-bold">Box Construction: </span>
                                            <span class="text-muted">@Model.BoxConstruction</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.BoxMaterial))
                                    {
                                        <div class="company-email mb-1">
                                            <span class="invoice-id font-weight-bold">Box Material: </span>
                                            <span class="text-muted">@Model.BoxMaterial</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.DoorDesignStyle))
                                    {
                                        <div class="company-email mb-1">
                                            <span class="invoice-id font-weight-bold">Style: </span>
                                            <span class="text-muted">@Model.DoorDesignStyle</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.DoorMaterial))
                                    {
                                        <div class="company-phone mb-1">
                                            <span class="invoice-id font-weight-bold">Door Material: </span>
                                            <span class="text-muted">@Model.DoorMaterial</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.DrawerHead))
                                    {
                                        <div class="company-phone mb-1">
                                            <span class="invoice-id font-weight-bold">Drawer Head: </span>
                                            <span class="text-muted">@Model.DrawerHead</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.CabinetColor))
                                    {
                                        <div class="company-phone mb-1">
                                            <span class="invoice-id font-weight-bold">Color: </span>
                                            <span class="text-muted">@Model.CabinetColor</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.CabinetGlaze))
                                    {
                                        <div class="company-phone mb-1">
                                            <span class="invoice-id font-weight-bold">Glaze: </span>
                                            <span class="text-muted">@Model.CabinetGlaze</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.IslandColor))
                                    {
                                        <div class="company-phone mb-1">
                                            <span class="invoice-id font-weight-bold">Color (island): </span>
                                            <span class="text-muted">@Model.IslandColor</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.IslandGlaze))
                                    {
                                        <div class="company-phone mb-1">
                                            <span class="invoice-id font-weight-bold">Glaze (island): </span>
                                            <span class="text-muted">@Model.IslandGlaze</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.FrameOption))
                                    {
                                        <div class="company-phone mb-1">
                                            <span class="invoice-id font-weight-bold">Frame Option (inset only): </span>
                                            <span class="text-muted">@Model.FrameOption</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.HingeTypeInset))
                                    {
                                        <div class="company-phone mb-1">
                                            <span class="invoice-id font-weight-bold">Hinge Type (inset): </span>
                                            <span class="text-muted">@Model.HingeTypeInset</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.HingeTypeOverlay))
                                    {
                                        <div class="company-phone mb-1">
                                            <span class="invoice-id font-weight-bold">Hinge Type (overlay): </span>
                                            <span class="text-muted">@Model.HingeTypeOverlay</span>
                                        </div>
                                    }
                                </div>
                            </div>

