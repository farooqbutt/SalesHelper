
<div class="content-overlay"></div>
<div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title mb-0">All Drafts</h3>
        </div>
        <div class="content-header-right col-md-6 col-12 mb-md-0 mb-2">
            <span class="dropdown">
                <button id="btnQuote" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true"
                        class="btn btn-primary dropdown-menu-right dropdown-toggle btn-md float-right">
                    <i class="fa fa-plus"></i> New Draft
                </button>
                <span aria-labelledby="btnQuote" class="dropdown-menu dropdown-menu-right mt-1">
                    <a asp-controller="PurchaseOrders" asp-action="CreateCabinetDraftOrder" class="dropdown-item">Cabinet Draft</a>
                    <a asp-controller="PurchaseOrders" asp-action="" class="dropdown-item">Countertop Draft</a>
                    <a asp-controller="PurchaseOrders" asp-action="" class="dropdown-item">Hardware Draft</a>
                    <a asp-controller="PurchaseOrders" asp-action="" class="dropdown-item">Installation Draft</a>
                </span>
            </span>
        </div>
    </div>
    <div class="content-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-content collpase show">
                        <div class="card-body card-dashboard">
                            <table id="DraftOrdersList" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Draft #</th>
                                        <th>Tag Name</th>
                                        <th>Customer</th>
                                        <th>Sale #</th>
                                        <th>Vendor</th>
                                        <th>Order Type</th>
                                        <th>Date Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Get Draft Orders
        $('#DraftOrdersList').DataTable({
            "ajax": {
                "url": "/PurchaseOrders/GetAllDraftOrders",
                "type": "GET",
                "dataType": "json",
                "dataSrc": "data"
            },
            "columns": [
                { "data": "id" },
                { "data": "orderName" },
                {
                    "data": null,
                    "render": function (data, type, row) {
                        return `
                                <a href="/Customers/CustomerDetailedView/${row.customerFK.id}">
                                    ${row.customerFK.firstName}
                                    ${row.customerFK.lastName ? row.customerFK.lastName : ''}
                                </a>
                                `;
                    }
                },
                { "data": "salesOrderId" },
                { "data": "vendorFK.companyName" },
                { "data": "orderType" },
                {
                    "data": null,
                    "render": function (data, type, row) {
                        return moment(row.dateCreated).format('MM/DD/YYYY');
                    }
                },
                {
                    "data": null,
                    "render": function (data, type, row) {
                        return `
                                <span class="dropdown">
                                    <a data-toggle="dropdown" class="dropdown-toggle dropdown-menu-right"><i class="fa fa-ellipsis-v"></i></a>
                                    <span class="dropdown-menu mt-1 dropdown-menu-right" x-placement="bottom-end">
                                        <a class="dropdown-item edit"><i class="feather icon-edit-2"></i>Edit</a>
                                        <a class="dropdown-item"><i class="feather icon-refresh-cw primary"></i> Convert to Purchase Order</a>
                                    </span>
                                </span>
                            `;
                    }
                }
            ]
        });
    });
</script>