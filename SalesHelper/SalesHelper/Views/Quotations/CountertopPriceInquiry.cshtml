@* Estimate Request Modal for sending email *@
<div class="modal fade text-left" id="EstiamteRequestModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-sm modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary white">
                <h4 class="modal-title form-section"><i class="feather icon-file-text"></i> Estimate Request Email Detials</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form class="form" id="EstimateRequestForm" method="post">
                <div class="modal-body">

                    <label>To</label>
                    <div class="form-group position-relative has-icon-left">
                        <input id="to" type="text" class="form-control" placeholder="jane.doe@gmail.com" value="@Model.CountertopMaterials.First().VendorIdFk!.Email" readonly />
                        <div class="form-control-position">
                            <i class="feather icon-mail primary"></i>
                        </div>
                    </div>

                    <label>Subject</label>
                    <div class="form-group position-relative has-icon-left">
                        <input id="subject" type="text" class="form-control" placeholder="(e.g) Estimate Request" value="Estimate Request" required />
                        <div class="form-control-position">
                            <i class="feather icon-file-text primary"></i>
                        </div>
                    </div>

                    <label>Body</label>
                    <div class="form-group">
                        <textarea id="body" type="text" class="form-control" placeholder="Type Something here..."
                                  value="Please provide me an estimate for items in attached PDF file." required></textarea>
                    </div>

                    <label>Attachment</label>
                    <div class="form-group position-relative has-icon-left">
                        <input type="file" id="attachment" class="form-control" />
                        <div class="form-control-position">
                            <i class="feather icon-paperclip primary"></i>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn grey btn-outline-secondary" data-dismiss="modal"><i class="feather icon-x"></i> Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="feather icon-send"></i> Send</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    function OpenOrDownloadAttachment(contentType, fileName, base64Data) {
        event.preventDefault(); // preventing other events to be triggered
        // Convert base64 data to a Blob object
        const byteNumbers = atob(base64Data.replace(/^.*,/, ''));
        const byteArray = new Array(byteNumbers.length);
        for (let i = 0; i < byteNumbers.length; i++) {
            byteArray[i] = byteNumbers.charCodeAt(i);
        }
        const blob = new Blob([new Uint8Array(byteArray)], { type: contentType });
        // Check the content type and open in a new tab or download based on the type
        if (contentType.startsWith('application/pdf') || contentType.startsWith('image/')) {
            // Open in a new tab
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.target = '_blank';
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } else {
            // Download
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = fileName;
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    }

    function SendEstimateRequest() {
        $('#EstiamteRequestModal').modal('show');
    }

    // submit EstiamteRequestForm
    $('#EstimateRequestForm').submit(function (e) {
        e.preventDefault();
        var formData = new FormData();
        formData.append('to', $('#to').val());
        formData.append('subject', $('#subject').val());
        formData.append('body', $('#body').val());
        formData.append('quoteId', @Model.CountertopQuotation.Id);
        formData.append('vendorId', @Model.CountertopMaterials.First().VendorId);
        formData.append('attachmentName', "Estimate-Request-" + @Model.CountertopQuotation.Id + ".pdf");

        var fileInput = $('#attachment')[0].files[0];
        formData.append('attachment', fileInput);

        $.ajax({
            type: "POST",
            url: "/Quotations/SendCountertopQuoteEstimateRequest",
            data: formData,
            contentType: false,
            processData: false,
            success: function (response) {
                $('#EstiamteRequestModal').modal('hide');
                if (response.message == "success") {
                    toastr.success(response.result, 'Success!', { "progressBar": true });
                }
                else {
                    if (response.result == "MailSettings_Not_Found") {
                        toastr.info("Mail Settings not found! Please add your mail settings first.", 'Information!', { "progressBar": true });
                        $('#MailSettingsModal').modal('show');
                    } else {
                        toastr.info(response.result, 'Information!', { "progressBar": true });
                    }
                }
            },
            error: function (error) {
                toastr.error(error, 'Error!', { "progressBar": true });
            }
        });
    });

</script>