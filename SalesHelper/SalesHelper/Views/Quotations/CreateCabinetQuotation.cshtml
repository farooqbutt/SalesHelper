@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> _signInManager
@inject SalesHelper.Services.CustomerService _customerService
@inject SalesHelper.Services.VendorService _vendorService
@{
    var customerId = TempData["CustomerId"];
    var customersList = _customerService.ReadAll().Where(a => a.CreatedByUserId == _signInManager.UserManager.GetUserAsync(User).Result.Id);
    // getting vendors for cabinetry business type (1 == "Cabinetry")
    var cabinetryVendors = _vendorService.ReadAll().Where(v => v.AccountNumberId == _signInManager.UserManager.GetUserAsync(User).Result.AccountNumber && v.BusinessTypeId == 1).ToList();

    //list of sections
    var sectionsNames = Enum.GetValues(typeof(CabinetDetail.SectionNames))
                        .Cast<CabinetDetail.SectionNames>()
                        .Select(e => e.GetEnumMemberAttributeValue())
                        .ToList();
    //list of constructions
    var constructions = Enum.GetValues(typeof(CabinetDetail.Constructions))
                        .Cast<CabinetDetail.Constructions>()
                        .Select(e => e.GetEnumMemberAttributeValue())
                        .ToList();
    var boxMaterials = Enum.GetValues(typeof(CabinetDetail.BoxMaterials))
                        .Cast<CabinetDetail.BoxMaterials>()
                        .Select(e => e.GetEnumMemberAttributeValue())
                        .ToList();
    //list of wood species
    var woodSpecies = Enum.GetValues(typeof(CabinetDetail.WoodSpecies))
                        .Cast<CabinetDetail.WoodSpecies>()
                        .Select(e => e.GetEnumMemberAttributeValue())
                        .ToList();
}
<style>
    #additionalInformationHeading {
        padding-left: 0;
        padding-right: 0;
    }

    .select2-selection {
        border-radius: 0px !important;
    }

    .input-group > .select2-container--default {
        width: auto;
        flex: 1 1 auto;
    }

    .input-group > .select2-container--default .select2-selection--single {
        height: 100%;
        line-height: inherit;
    }
</style>

<div class="content-overlay"></div>
<div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title mb-0">New Cabinet Quotation</h3>
            <div class="row breadcrumbs-top">
                <div class="breadcrumb-wrapper col-12">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Quotations" asp-action="QuotationsListView">Quotations</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a>Create Cabinet Quote</a>
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="content-body">

        <div class="card">
            <div class="card-header">
                <h4 class="card-title text-primary">Cabinet Quote</h4>
            </div>
            <div class="card-content collapse show">
                <div class="card-body">
                    <form class="form" id="CabinetQuoteForm">

                        @* some hidden fields here *@
                        <div class="hidden">
                        <input id="CreatedDateTime" value="@DateTime.Now.ToString("yyyy-MM-ddThh:mm")" />
                        <input id="ModifiedDateTime" value="@DateTime.Now.ToString("yyyy-MM-ddThh:mm")" />
                        <input id="CreatedByUserId" value="@_signInManager.UserManager.GetUserAsync(User).Result.Id" />
                        </div>

                        <div class="form-body">

                            <div class="form-group">
                                <label>Customer Name <span class="required">*</span></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text square" style="height: 100%; padding: 0 10px; display: flex; align-items: center;">
                                            <i class="feather icon-user" style="font-size: 1rem;"></i>
                                        </span>
                                    </div>
                                    <select class="form-control square" id="CustomerId" data-placeholder="Select a Customer" required></select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Quote Name <span class="required">*</span></label>
                                <input class="form-control form-control-sm square" id="CabinetQuoteName" placeholder="Quote Name" required />
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <h4 class="card-title text-primary">Cabinet Details</h4>
                                </div>
                                <div class="col-md-6">
                                    <button type="button" class="btn mr-1 mb-1 btn-primary btn-sm float-right" onclick="addCabinetDetailRow()"><i class="feather icon-plus"></i> Add Detail</button>
                                </div>
                            </div>

                            <table class="table table-responsive" id="cabinetDetailsTable">
                                <thead>
                                    <tr>
                                        <th>Section</th>
                                        <th>Cabinetry</th>
                                        <th>Construction</th>
                                        <th>Box Materials</th>
                                        <th>Wood Sopecies</th>
                                        <th>Door Style</th>
                                        <th>Finish</th>
                                        <th>Action</th>                                        
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>

                            <div class="form-group">
                                <label>Comments on Cabinet Details</label>
                                <textarea class="form-control form-control-sm square" id="CommentsOnCabinetDetails" placeholder="Comments on Cabinet Details..."></textarea>
                            </div>

                        </div>

                        <div id="additionalInformationWrap" role="tablist" aria-multiselectable="true">
                            <div class="card accordion collapse-icon panel mb-0 box-shadow-0 border-0">

                                <div id="additionalInformationHeading" role="tab" class="card-header card-collapse" data-toggle="collapse" href="#additionalInformationAccordion" aria-expanded="false" aria-controls="additionalInformationAccordion">
                                    <h4 class="card-title text-primary">
                                        Additional Information
                                    </h4>
                                </div>
                                <div id="additionalInformationAccordion" role="tabpanel" data-parent="#additionalInformationWrap" aria-labelledby="additionalInformationHeading" class="collapse" aria-expanded="false">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Refrigerator</label>
                                                <select id="Refrigerator" class="form-control square">
                                                    <option value='18" Refrigerator'>18" Refrigerator</option>
                                                    <option value='24" Refrigerator'>24" Refrigerator</option>
                                                    <option value='30" Refrigerator'>30" Refrigerator</option>
                                                    <option value='33" Refrigerator'>33" Refrigerator</option>
                                                    <option value='36" Refrigerator' selected>36" Refrigerator</option>
                                                    <option value='42" Refrigerator'>42" Refrigerator</option>
                                                    <option value='48" Refrigerator'>48" Refrigerator</option>
                                                    <option value='60" Refrigerator'>60" Refrigerator</option>
                                                    <option value='18" Panel-Ready Refrigerator'>18" Panel-Ready Refrigerator</option>
                                                    <option value='24" Panel-Ready Refrigerator'>24" Panel-Ready Refrigerator</option>
                                                    <option value='30" Panel-Ready Refrigerator'>30" Panel-Ready Refrigerator</option>
                                                    <option value='33" Panel-Ready Refrigerator'>33" Panel-Ready Refrigerator</option>
                                                    <option value='36" Panel-Ready Refrigerator'>36" Panel-Ready Refrigerator</option>
                                                    <option value='42" Panel-Ready Refrigerator'>42" Panel-Ready Refrigerator</option>
                                                    <option value='48" Panel-Ready Refrigerator'>48" Panel-Ready Refrigerator</option>
                                                    <option value='60" Panel-Ready Refrigerator'>60" Panel-Ready Refrigerator</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label>Dishwasher</label>
                                                <select id="Dishwasher" class="form-control square">
                                                    <option value="No Dishwasher">No Dishwasher</option>
                                                    <option value="18&quot; Dishwasher">18" Dishwasher</option>
                                                    <option value="24&quot; Standard Dishwasher" selected>24" Standard Dishwasher</option>
                                                    <option value="24&quot; Panel Ready Dishwasher">24" Panel Ready Dishwasher</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label>Built-in Oven</label>
                                                <select id="BuiltInOven" class="form-control square">
                                                    <option value="N/A" selected>N/A</option>
                                                    <option value="24&quot; Built-in Microwave">24" Built-in Microwave</option>
                                                    <option value="27&quot; Built-in Single Oven">27" Built-in Single Oven</option>
                                                    <option value="27&quot; Built-in Double Oven">27" Built-in Double Oven</option>
                                                    <option value="30&quot; Built-in Microwave">30" Built-in Microwave</option>
                                                    <option value="30&quot; Built-in Steam Oven">30" Built-in Steam Oven</option>
                                                    <option value="30&quot; Built-in Single Oven">30" Built-in Single Oven</option>
                                                    <option value="30&quot; Built-in Double Oven">30" Built-in Double Oven</option>
                                                    <option value="30&quot; Built-in Microve/Oven Combo">30" Built-in Microve/Oven Combo</option>
                                                    <option value="30&quot; Built-in Microve Over Oven">30" Built-in Microve Over Oven</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label>Sink</label>
                                                <select id="Sink" class="form-control square">
                                                    <option value="N/A">N/A</option>
                                                    <option value="24~28&quot; Top Mount Sink">24~28" Top Mount Sink</option>
                                                    <option value="30~32&quot; Top Mount Sink">30~32" Top Mount Sink</option>
                                                    <option value="33~36&quot; Top Mount Sink">33~36" Top Mount Sink</option>
                                                    <option value="37+&quot; Top Mount Sink">37+" Top Mount Sink</option>
                                                    <option value="24~28&quot; Under Mount Sink">24~28" Under Mount Sink</option>
                                                    <option value="30~32&quot; Under Mount Sink">30~32" Under Mount Sink</option>
                                                    <option value="33~36&quot; Under Mount Sink">33~36" Under Mount Sink</option>
                                                    <option value="37+&quot; Under Mount Sink">37+" Under Mount Sink</option>
                                                    <option value="27&quot; Farmhouse Sink">27" Farmhouse Sink</option>
                                                    <option value="30&quot; Farmhouse Sink" selected>30" Farmhouse Sink </option>
                                                    <option value="33&quot; Farmhouse Sink">33" Farmhouse Sink</option>
                                                    <option value="36&quot; Farmhouse Sink">36" Farmhouse Sink</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Stove or Cooktop</label>
                                                <select id="StoveAndCooktop" class="form-control square">
                                                    <option value="18&quot; Stove">18" Stove</option>
                                                    <option value="24&quot; Stove">24" Stove</option>
                                                    <option value="30&quot; Stove" selected>30" Stove</option>
                                                    <option value="36&quot; Stove">36" Stove</option>
                                                    <option value="42&quot; Stove">42" Stove</option>
                                                    <option value="48&quot; Stove">48" Stove</option>
                                                    <option value="60&quot; Stove">60" Stove</option>
                                                    <option value="18&quot; Cooktop">18" Cooktop</option>
                                                    <option value="24&quot; Cooktop">24" Cooktop</option>
                                                    <option value="24&quot; Rangetop">24" Rangetop</option>
                                                    <option value="30&quot; Cooktop">30" Cooktop</option>
                                                    <option value="30&quot; Rangetop">30" Rangetop</option>
                                                    <option value="36&quot; Cooktop">36" Cooktop</option>
                                                    <option value="36&quot; Rangetop">36" Rangetop</option>
                                                    <option value="42&quot; Cooktop">42" Cooktop</option>
                                                    <option value="42&quot; Rangetop">42" Rangetop</option>
                                                    <option value="48&quot; Cooktop">48" Cooktop</option>
                                                    <option value="48&quot; Rangetop">48" Rangetop</option>
                                                    <option value="60&quot; Rangetop">60" Rangetop</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label>Hood</label>
                                                <select id="Hood" class="form-control square">
                                                    <option value="30&quot; Microwave Hood">30" Microwave Hood</option>
                                                    <option value="30&quot; Decoration Hood" selected>30" Decoration Hood</option>
                                                    <option value="33&quot; Decoration Hood">33" Decoration Hood</option>
                                                    <option value="36&quot; Decoration Hood">36" Decoration Hood</option>
                                                    <option value="42&quot; Decoration Hood">42" Decoration Hood</option>
                                                    <option value="48&quot; Decoration Hood">48" Decoration Hood</option>
                                                    <option value="60&quot; Decoration Hood">60" Decoration Hood</option>
                                                    <option value="30&quot; Under Cabinet Hood">30" Unnder Cabinet Hood</option>
                                                    <option value="36&quot; Under Cabinet Hood">36" Unnder Cabinet Hood</option>
                                                    <option value="48&quot; Under Cabinet Hood">48" Unnder Cabinet Hood</option>
                                                    <option value="Custom Wood Hood">Custom Wood Hood</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label>Built-in Drawer Microwave</label>
                                                <select id="BuiltInDrawerMicrowave" class="form-control square">
                                                    <option value="N/A">N/A</option>
                                                    <option value="24&quot; Drawer Microwave" selected>24" Drawer Microwave</option>
                                                    <option value="30&quot; Drawer Microwave">30" Drawer Microwave</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label>Comments</label>
                                                <textarea id="CommentsOnAdditionalInfo" rows="2" class="form-control form-control-sm square" placeholder="Additional Comments"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions text-center">
                            <a asp-controller="Quotations" asp-action="QuotationsListView" type="reset" class="width-150 btn btn-warning"><i class="feather icon-x"></i> Cancel</a>
                            <button id="btnSaveNext" class="width-150 btn btn-primary">Save & Next <i class="feather icon-arrow-right"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@* Creating a model pop up for adding customer *@
<!-- Modal for adding customer -->
<div class="modal fade text-left" id="AddCustomerModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-sm modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary white">
                <h4 class="modal-title form-section"><i class="feather icon-user-plus"></i> Add New Customer</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form class="form" id="AddCustomerForm" method="post">
                <div class="modal-body">
                    <label>Customer Name *</label>
                    <div class="form-group position-relative has-icon-left">
                        <input id="customerName" type="text" class="form-control" placeholder="Jane Doe" required>
                        <div class="form-control-position">
                            <i class="feather icon-user primary"></i>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn grey btn-outline-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>

    function addCabinetDetailRow() {
        var newRow = `
                    <tr>
                    <td>
                        <select class="form-control square sectionName" placeholder="section">
                            @foreach (var sectionName in sectionsNames)
                            {
                                <option value="@sectionName">@sectionName</option>
                            }
                        </select>
                    </td>
                    <td>
                        <select class="form-control square cabinetryVendor" placeholder="cabinetry">
                            @foreach (var vendor in cabinetryVendors)
                            {
                                <option value="@vendor.VendorId">@vendor.CompanyName</option>
                            }
                        </select>
                    </td>
                    <td>
                        <select class="form-control square constructions" placeholder="construction">
                            @foreach (var construction in constructions)
                            {
                                <option value="@construction">@construction</option>
                            }
                        </select>
                    </td>
                    <td>
                        <select class="form-control square boxMaterials" placeholder="box materials">
                            @foreach (var boxMaterial in boxMaterials)
                            {
                                <option value="@boxMaterial">@boxMaterial</option>
                            }
                        </select>
                    </td>
                    <td>
                        <select class="form-control square woodSpecies" placeholder="wood species">
                            @foreach (var woodSpecie in woodSpecies)
                            {
                                <option value="@woodSpecie">@woodSpecie</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input class="form-control form-control-sm square" placeholder="Door Style" />
                    </td>
                    <td>
                            <input class="form-control form-control-sm square" placeholder="Finish" />
                    </td>
                    <td style="vertical-align:middle;">
                        <button class=" btn btn-sm btn-danger delete-row"><i class="feather icon-trash" title="Delete Cabinet Details"></i></button>
                    </td>
                    </tr>
                `;

        $("#cabinetDetailsTable tbody").append(newRow);

        //convert newRow to HTML tr element
        var addedRow = $('#cabinetDetailsTable tbody tr:last-child');
        configuringSelectLists(addedRow);
    }

    // Helper function to configure select2
    function configureSelect2(selectList) {
        selectList.select2({
            tags: true,
            placeholder: 'Select or type',
            allowClear: true,
            createTag: function (params) {
                return {
                    id: params.term,
                    text: params.term,
                    newOption: true
                };
            },
            templateResult: function (data) {
                var $result = $("<span></span>");
                $result.text(data.text);
                return $result;
            },
            width: '100%'
        });
        // clearing vendor select for first time
        selectList.val(null).trigger('change');
    }

    function configuringSelectLists(addedRow){
        //cabinetry vendor configuration
        var cabinetryVendor = addedRow.find('.cabinetryVendor');
        cabinetryVendor.select2({
            placeholder: "Select Cabinetry",
            width: "100%",
            language: {
                "noResults": function () {
                    return "No Vendor Found!";
                }
            },
            escapeMarkup: function (markup) {
                return markup;
            }
        });
        // clearing vendor select for first time
        cabinetryVendor.val(null).trigger('change');

        //sectionName, construction, boxMaterials, and woodSpecies configuration using for loop
        var sectionName = addedRow.find('.sectionName');
        var constructions = addedRow.find('.constructions');
        var boxMaterials = addedRow.find('.boxMaterials');
        var woodSpecies = addedRow.find('.woodSpecies');
        var selectLists = [sectionName, constructions, boxMaterials, woodSpecies];
        for (var i = 0; i < selectLists.length; i++){
            configureSelect2(selectLists[i]);
        }
    }

    // Remove row when the "Delete Item" button is clicked
    $('#cabinetDetailsTable').on('click', '.delete-row', function () {
        $(this).closest('tr').remove();
    });

    function GetCabinetDetails() {
        var listOfCabinetDetails = new Array();
        $("#cabinetDetailsTable").find("tr:gt(0)").each(function () {
            var sectionName = $(this).find("td:eq(0)").find("select").val();
            var vendorId = $(this).find("td:eq(1)").find("select").val();
            var construction = $(this).find("td:eq(2)").find("select").val();
            var boxMaterial = $(this).find("td:eq(3)").find("select").val();
            var woodSpecie = $(this).find("td:eq(4)").find("select").val();
            var doorStyle = $(this).find("td:eq(5)").find("input").val();
            var cabinetFinish = $(this).find("td:eq(6)").find("input").val();

            var CabinetDetail = {};

            CabinetDetail.sectionName = sectionName;
            CabinetDetail.vendorId = vendorId;
            CabinetDetail.construction = construction;
            CabinetDetail.boxMaterial = boxMaterial;
            CabinetDetail.woodSpecie = woodSpecie;
            CabinetDetail.doorStyle = doorStyle;
            CabinetDetail.cabinetFinish = cabinetFinish;

            listOfCabinetDetails.push(CabinetDetail);
        });
        return listOfCabinetDetails;
    }

    // submit CabinetQuoteForm form
    $("#CabinetQuoteForm").submit(function (e) {
        e.preventDefault();
        // hidden fields
        var createdDateTime = $("#CreatedDateTime").val();
        var modifiedDateTime = $("#ModifiedDateTime").val();
        var createdByUserId = $("#CreatedByUserId").val();
        /////////
        var customerId = $("#CustomerId").val();
        var cabinetQuoteName = $("#CabinetQuoteName").val();
        var commentsOnCabinetDetails = $("#CommentsOnCabinetDetails").val();
        var refrigerator = $("#Refrigerator").val();
        var dishwasher = $("#Dishwasher").val();
        var builtInOven = $("#BuiltInOven").val();
        var sink = $("#Sink").val();
        var stoveAndCooktop = $("#StoveAndCooktop").val();
        var hood = $("#Hood").val();
        var builtInDrawerMicrowave = $("#BuiltInDrawerMicrowave").val();
        var commentsOnAdditionalInfo = $("#CommentsOnAdditionalInfo").val();
        var cabinetDetailsList = GetCabinetDetails();
        
        var data = {
            createdDateTime: createdDateTime,
            modifiedDateTime: modifiedDateTime,
            createdByUserId: createdByUserId,
            customerId: customerId,
            cabinetQuoteName: cabinetQuoteName,
            commentsOnCabinetDetails: commentsOnCabinetDetails,
            refrigerator: refrigerator,
            dishwasher: dishwasher,
            builtInOven: builtInOven,
            sink: sink,
            stoveAndCooktop: stoveAndCooktop,
            hood: hood,
            builtInDrawerMicrowave: builtInDrawerMicrowave,
            commentsOnAdditionalInfo: commentsOnAdditionalInfo,
            cabinetDetailsList: cabinetDetailsList
        };

        $.ajax({
            type: "POST",
            url: "/Quotations/CreateCabinetQuotation",
            data: data,
            success: function (data) {
                if(data.result != null){
                    window.location.href = "/Quotations/CabinetQuotationDetailedView/" + data.result;
                }
            },
            error: function (error) {
                alert(error);
            }
        });
    });

    // submit AddCustomerForm form
    $("#AddCustomerForm").submit(function (e) {
        e.preventDefault();
        var customerName = $("#customerName").val();
        $.ajax({
            type: "POST",
            url: "/Customers/AddCustomerFromSearchBar",
            data: { name: customerName },
            success: function (data) {
                // close the modal
                $("#AddCustomerModal").modal("hide");
                // refresh the customer select list
                var customerId = data.data.id;
                var customerName = data.data.firstName + " " + (data.data.lastName != null ? data.data.lastName : "");
                var newOption = new Option(customerName, customerId, true, true);
                $("#CustomerId").append(newOption).trigger("change");
            }
        });
    });

    function ShowCustomer_Canvas() {
        // get the current text that is inside select2 search input
        var searchText = $("#CustomerId").data("select2").dropdown.$search.val();
        // show customer modal pop up
        $("#AddCustomerModal").modal("show");
        // set customer name input field equal to searchText
        $("#customerName").val(searchText);
        // close select2 list
        $("#CustomerId").select2("close");
    }

    $(document).ready(function () {
        // For Customers Select List
        var customerList = @Html.Raw(Json.Serialize(customersList));
        $("#CustomerId").select2({
            placeholder: $(this).data("placeholder"),
            language: {
                noResults: function () {
                    return `<button style="width: 100%" type="button"
                                class="btn btn-primary"
                                onClick='ShowCustomer_Canvas()'><i class="feather icon-plus"></i> Add New Customer</button>
                                </li>`;
                }
            },
            escapeMarkup: function (markup) {
                return markup;
            },
            width: $(this).data('width') ? $(this).data('width') : $(this).hasClass('w-100') ? '100%' : 'style',
            data: customerList.map(function (customer) {
                return {
                    id: customer.id,
                    text: customer.firstName + " " + (customer.lastName != null ? customer.lastName : "")
                };
            })
        });
        $("#CustomerId").val(@Html.Raw(customerId != null ? $"\"{customerId}\"" : "null")).trigger("change");


        // For Cabinetry Vendors Select List
        var cabinetryVendorsList = @Html.Raw(Json.Serialize(cabinetryVendors));
        $("#VendorId").select2({
            placeholder: $(this).data("placeholder"),
            width: $(this).data('width') ? $(this).data('width') : $(this).hasClass('w-100') ? '100%' : 'style',
            data: cabinetryVendorsList.map(function (vendor) {
                return {
                    id: vendor.vendorId,
                    text: vendor.companyName
                };
            })
        });
        $("#VendorId").val(null).trigger("change");

        // Show and hide one color or multi color design divs
        $('input[type=radio][name=isOneColorDesign]').change(function () {
            if (this.value == 'true') {
                $("#oneColorDesignDiv").removeAttr('hidden');
                $("#multiColorDesignDiv").attr('hidden', true);
            }
            else if (this.value == 'false') {
                $("#multiColorDesignDiv").removeAttr('hidden');
                $("#oneColorDesignDiv").attr('hidden', true);
            }
        });
    });
</script>