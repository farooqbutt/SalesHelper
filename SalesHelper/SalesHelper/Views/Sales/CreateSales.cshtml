    // Function to calculate subtotal
    function calculateSubtotal(input) {
        // Get the closest table row
        const row = input.closest('tr');
        // Retrieve the values of Estimated Square Feet and Unit Price
        const estSqFt = parseFloat(row.querySelector('.est-sqft').value) || 0;
        const unitPrice = parseFloat(row.querySelector('.unit-price').value) || 0;
        // Calculate the subtotal
        const subtotal = estSqFt * unitPrice;
        // Set the subtotal value in the readonly input
        row.querySelector('.subtotal').value = subtotal.toFixed(2);

        // Calculate the total of subtotals
        const subtotals = Array.from(document.querySelectorAll('.subtotal')).map(subtotal => parseFloat(subtotal.value) || 0);
        const totalOfSubtotals = subtotals.reduce((total, subtotal) => total + subtotal, 0);
        document.getElementById('totalOfSubtotals').textContent = "$" + totalOfSubtotals.toFixed(2);
    }

