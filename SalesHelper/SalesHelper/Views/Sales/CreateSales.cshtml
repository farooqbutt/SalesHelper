                SectionName: $(this).find('.sectionName').val(),
                VendorId: $(this).find('.cabinetryVendor').val(),
                Construction: $(this).find('.constructions').val(),
                BoxMaterial: $(this).find('.boxMaterials').val(),
                WoodSpecie: $(this).find('.woodSpecies').val(),
                DoorStyle: $(this).find('input[placeholder="Door Style"]').val(),
                CabinetFinish: $(this).find('input[placeholder="Finish"]').val(),
                Description: $(this).find('input[placeholder="Description"]').val(),
                CabinetQuotationId: $(this).find('.cabinetQuoteId').val()
            };
            cabinetDetails.push(cabinetDetail);
        });

        var countertopDetails = [];
        $("#countertopDetailsTable tbody tr").each(function () {
            var countertopDetail = {
                Material: $(this).find('td:eq(0)').text(),
                Brand: $(this).find('td:eq(1)').text(),
                Color: $(this).find('td:eq(2)').text(),
                VendorId: $(this).find('.vendor-select').val(),
                RoomType: $(this).find('.room-type-select').val(),
                EdgeProfile: $(this).find('.edge-profile-select').val(),
                EstimatedSquareFeet: $(this).find('.est-sqft').val(),
                UnitPrice: $(this).find('.unit-price').val(),
                Subtotal: $(this).find('.subtotal').val(),
                CountertopQuotationId: $(this).find('.countertopQuoteId').val()
            };
            countertopDetails.push(countertopDetail);
        });

        var data = {
            saleData: sale,
            cabinetItems: cabinetDetails,
            countertopItems: countertopDetails
        };

        return data;
    }

    // submit SalesForm form
    $("#SalesForm").submit(function (e) {
        e.preventDefault();
        
        var data = GatherFormData();

        $.ajax({
            type: "POST",
            url: "/Sales/CreateSales",
            data: data,
            success: function (data) {
                Swal.fire({
                    title: 'Sale Created Successfully',
                    icon: 'success'
                }).then((result) => {
                    window.location.href = "/Sales/SalesList";
                });
            },
            error: function (error) {
                Swal.fire({
                    title: 'Error Creating Sale',
                    icon: 'error'
                });
            }
        });
    });


    // invoice section work
    document.querySelectorAll('.expandableSpan').forEach(function (element) {
        element.addEventListener('input', function (e) {
            var text = this.innerText;
            // Remove any character that is not a digit or a period
            var numericText = text.replace(/[^0-9.]/g, '');

            // Split the text by period to check for multiple decimal points
            var parts = numericText.split('.');
            if (parts.length > 2) {
                // If more than one decimal point, keep only the first decimal point and join the rest
                numericText = parts[0] + '.' + parts.slice(1).join('');
            }

            if (text !== numericText) {
                this.innerText = numericText;
                // Move the caret to the end of the text
                var range = document.createRange();
                var sel = window.getSelection();
                range.setStart(this.childNodes[0], numericText.length);
                range.collapse(true);
                sel.removeAllRanges();
                sel.addRange(range);
            }
        });

        // Prevent non-numeric and multiple decimal points from being entered
        element.addEventListener('keydown', function (e) {
            if (!((e.key >= '0' && e.key <= '9') || e.key === '.' || e.key === 'Backspace' || e.key === 'Delete' || e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
                e.preventDefault();
            }

            // Prevent more than one decimal point
            if (e.key === '.' && this.innerText.includes('.')) {
                e.preventDefault();
            }
        });
    });


    // calculate the total sales order amount
    $("#cabinetSubtotal, #countertopSubtotal").on("focusout", function () {
        var cabinetSubtotal = parseFloat($("#cabinetSubtotal").text()) || 0;
        var countertopSubtotal = parseFloat($("#countertopSubtotal").text()) || 0;
        var invoiceTotal = cabinetSubtotal + countertopSubtotal;
        $("#TotalSalesOrderAmount").text(invoiceTotal.toFixed(2));
    });

    // calculate the grand total applying discount and tax
    $("#discountGiven, #tax").on("focusout", function () {
        var totalSalesOrderAmount = parseFloat($("#TotalSalesOrderAmount").text()) || 0;
        var discountGiven = parseFloat($("#discountGiven").text()) || 0;
        var taxPercentage = parseFloat($("#tax").text()) || 0;

        var discountAmount = discountGiven;
        var taxAmount = (taxPercentage / 100) * (totalSalesOrderAmount - discountAmount);
        var grandTotal = totalSalesOrderAmount - discountAmount + taxAmount;

        $("#GrandTotal").text(grandTotal.toFixed(2));
    });

    // calculate the balance 
    $("#AdvancePaid").on("focusout", function () {
        var grandTotal = parseFloat($("#GrandTotal").text()) || 0;
        var advancePaid = parseFloat($("#AdvancePaid").text()) || 0;
        var balance = grandTotal - advancePaid;
        $("#BalanceUSD").text("$" + balance.toFixed(2));
    });

    // on click of edit icon near expandableSpan, focus that span
    $(".focusSpan").on("click", function () {
        $(this).prev().focus();
    });

    function ShowSalePreview(buttonElement){
        // show loading icon in the button
        $(buttonElement).html('<i class="feather icon-loader"></i> Loading...');
        var data = GatherFormData();
        $.ajax({
            type: "POST",
            url: "/Sales/SalesPreview",
            data: data,
            ontentType: 'application/json; charset=utf-8',
            dataType: 'binary', // or remove this line, depending on your setup
            xhrFields: {
                responseType: 'blob' // Important for handling binary data
            },
            success: function (data) {
                debugger;
                var blob = new Blob([data], { type: 'application/pdf' });
                var url = window.URL.createObjectURL(blob);
                
                // Display the PDF in the modal
                var iframe = document.getElementById('pdfIframe');
                iframe.src = url;

                // open modal to show the preview
                $('#SalesOrderPreviewModal').modal('show');

                // Update button inside modal to open in new tab
                $('#printSaleOrderPreview').off('click').on('click', function () {
                    window.open(url);
                });
                
                $(buttonElement).html('<i class="feather icon-file-text"></i> Preview');
            },
            error: function (xhr, status, error) {
                alert('Error: ' + error);
                $(buttonElement).html('<i class="feather icon-file-text"></i> Preview');
            }
        });
    }
</script>