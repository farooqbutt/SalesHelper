<script>
    
    document.addEventListener("DOMContentLoaded", function () {
        function setupAutocomplete(inputId, cardId, addressPrefix) {
            var searchInput = document.getElementById(inputId);
            var autocomplete = new google.maps.places.Autocomplete(searchInput);
            autocomplete.setFields(["address_components", "formatted_address"]);
            autocomplete.addListener("place_changed", function () {
                var place = autocomplete.getPlace();
                var address = place.formatted_address;

                var blockui = ShowBlockUi(cardId, "Loading Address...");
                // setting address1, city, state & postalcode, country in the address fields
                var addressArray = address.split(",");

                var address1 = addressArray[0].trim();
                var city = addressArray[1].trim();
                var state = addressArray[2].trim().split(" ")[0];
                var postalCode = addressArray[2].trim().split(" ")[1];
                var country = addressArray[3].trim();

                $("#" + addressPrefix + "Address1").val(address1);
                $("#" + addressPrefix + "Country").val(country).trigger("change");
                // wait for states to be populated before setting the state
                var stateSetInterval = setInterval(function () {
                    if ($("#" + addressPrefix + "State option").length > 0) {
                        $("#" + addressPrefix + "State").val(state).trigger("change");
                        clearInterval(stateSetInterval);
                        // Unblock the UI after setting the state
                        $(blockui).unblock();
                    }
                }, 100);
                $("#" + addressPrefix + "City").val(city);
                $("#" + addressPrefix + "Zip").val(postalCode);
            });
        }

        setupAutocomplete("HomeAddress1", "HomeAddressCard", "Home");
        setupAutocomplete("ShippingAddress1", "ShippingAddressCard", "Shipping");
    });

    $(document).ready(function () {

        $.ajax({
            url: 'https://countriesnow.space/api/v0.1/countries/states',
            method: 'GET',
            success: function (data) {
                let countries = data.data.map(country => ({
                    id: country.iso3,
                    text: country.name
                }));
                $('#HomeCountry, #ShippingCountry').select2({
                    data: countries
                });
            },
            error: function (error) {
                console.log('Error fetching countries:', error);
            }
        });

        // on selecting home country get states using ajax request
        $('#HomeCountry').on('change', function () {
            var blockui = ShowBlockUi("HomeAddressCard", "Loading States...");
            // first clear all previous options from HomeState
            $('#HomeState').empty();
            var country = $('#HomeCountry option:selected').text();
            $.ajax({
                url: 'https://countriesnow.space/api/v0.1/countries/states',
                method: 'POST',
                data: { "country": country },
                success: function (data) {
                    let states = data.data.states.map(state => ({
                        id: state.state_code,
                        text: state.name
                    }));
                    $('#HomeState').select2({
                        data: states
                    });
                    // Unblock the UI after setting the state
                    $(blockui).unblock();
                },
                error: function (error) {
                    console.log('Error fetching states:', error);
                }
            });
        });

        // on selecting shipping country get states using ajax request
        $('#ShippingCountry').on('change', function () {
            var blockui = ShowBlockUi("ShippingAddressCard", "Loading States...");
            // first clear all previous options from ShippingState
            $('#ShippingState').empty();
            var country = $('#ShippingCountry option:selected').text();
            $.ajax({
                url: 'https://countriesnow.space/api/v0.1/countries/states',
                method: 'POST',
                data: { "country": country },
                success: function (data) {
                    let states = data.data.states.map(state => ({
                        id: state.state_code,
                        text: state.name
