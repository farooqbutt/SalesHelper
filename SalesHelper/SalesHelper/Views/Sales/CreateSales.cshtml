@* Creating a model pop up for adding customer *@
<!-- Modal for adding customer -->
<div class="modal fade text-left" id="AddCustomerModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-sm modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary white">
                <h4 class="modal-title form-section"><i class="feather icon-user-plus"></i> Add New Customer</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form class="form" id="AddCustomerForm" method="post">
                <div class="modal-body">
                    <label>Customer Name *</label>
                    <div class="form-group position-relative has-icon-left">
                        <input id="customerName" type="text" class="form-control " placeholder="Jane Doe" required>
                        <div class="form-control-position">
                            <i class="feather icon-user primary"></i>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn grey btn-outline-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('#HomeCountry, #ShippingCountry').select2({
            placeholder: 'Select a country',
            allowClear: true
        });

        $('#HomeState, #ShippingState').select2({
            tags: true,
            placeholder: 'Select or type a state',
            allowClear: true,
            createTag: function (params) {
                return {
                    id: params.term,
                    text: params.term,
                    newOption: true
                };
            },
            templateResult: function (data) {
                var $result = $("<span></span>");
                $result.text(data.text);
                return $result;
            }
        });

        $.ajax({
            url: 'https://restcountries.com/v3.1/all',
            method: 'GET',
            success: function (data) {
                let countries = data.map(country => ({
                    id: country.name.common,
                    text: country.name.common
                }));
                $('#HomeCountry, #ShippingCountry').select2({
                    data: countries
                });
            },
            error: function (error) {
                console.log('Error fetching countries:', error);
            }
        });

        var customerList = @Html.Raw(Json.Serialize(customersList));
        $("#CustomerId").select2({
            placeholder: $(this).data("placeholder"),
            language: {
                noResults: function () {
                    return `<button style="width: 100%" type="button"
                                                class="btn btn-primary"
                                                onClick='ShowCustomer_Canvas()'><i class="feather icon-plus"></i> Add New Customer</button>
                                                </li>`;
                }
            },
            escapeMarkup: function (markup) {
                return markup;
            },
            width: '100%',
            data: customerList.map(function (customer) {
                return {
                    id: customer.id,
                    text: customer.firstName + " " + (customer.lastName != null ? customer.lastName : "")
                };
            })
        });

        // on change of customer get customer address using ajax request
        $("#CustomerId").on("change", function () {
            var customerId = $(this).val();
            $.ajax({
                type: "GET",
                url: "/Customers/GetCustomer",
                data: { id: customerId },
                success: function (data) {
                    $("#HomeAddress1").val(data.addressIdFK.address1);
                    $("#HomeAddress2").val(data.addressIdFK.address2);
                    $("#HomeCity").val(data.addressIdFK.city);
                    $("#HomeCountry").val(data.addressIdFK.country).trigger("change");
                    $("#HomeState").val(data.addressIdFK.state).trigger("change");
                    $("#HomeZip").val(data.addressIdFK.postalCode);

                    $("#ShippingAddress1").val(data.addressIdFK.address1);
                    $("#ShippingAddress2").val(data.addressIdFK.address2);
                    $("#ShippingCity").val(data.addressIdFK.city);
                    $("#ShippingCountry").val(data.addressIdFK.country).trigger("change");
                    $("#ShippingState").val(data.addressIdFK.state).trigger("change");
                    $("#ShippingZip").val(data.addressIdFK.postalCode);
                },
                error: function (error) {
                    console.log("Error fetching customer address:", error);
                }
            });
        });
    });

    // submit AddCustomerForm form
    $("#AddCustomerForm").submit(function (e) {
        e.preventDefault();
        var customerName = $("#customerName").val();
        $.ajax({
            type: "POST",
            url: "/Customers/AddCustomerFromSearchBar",
            data: { name: customerName },
            success: function (data) {
                // close the modal
                $("#AddCustomerModal").modal("hide");
                // refresh the customer select list
                var customerId = data.data.id;
                var customerName = data.data.firstName + " " + (data.data.lastName != null ? data.data.lastName : "");
                var newOption = new Option(customerName, customerId, true, true);
                $("#CustomerId").append(newOption).trigger("change");
            }
        });
    });

    function ShowCustomer_Canvas() {
        // get the current text that is inside select2 search input
        var searchText = $("#CustomerId").data("select2").dropdown.$search.val();
        // show customer modal pop up
        $("#AddCustomerModal").modal("show");
        // set customer name input field equal to searchText
        $("#customerName").val(searchText);
        // close select2 list
        $("#CustomerId").select2("close");
    }


    // cabinet items section functions for adding simple items
    function addCabinetDetailRow() {
        var newRow = `
                                    <tr>
                                    <td>
                                            <select class="form-control form-control-sm square sectionName" placeholder="section">
    @foreach (var sectionName in sectionsNames)
    {
                                                                <option value="@sectionName">@sectionName</option>
    }
                                        </select>
                                    </td>
                                    <td>
                                            <select class="form-control form-control-sm square cabinetryVendor" placeholder="cabinetry">
    @foreach (var vendor in cabinetryVendors)
    {
                                                                <option value="@vendor.VendorId">@vendor.CompanyName</option>
    }
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-control form-control-sm square constructions" placeholder="construction">
    @foreach (var construction in constructions)
    {
                                                                <option value="@construction">@construction</option>
    }
                                        </select>
                                    </td>
                                    <td>
                                            <select class="form-control form-control-sm square boxMaterials" placeholder="box materials">
    @foreach (var boxMaterial in boxMaterials)
    {
                                                                <option value="@boxMaterial">@boxMaterial</option>
    }
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-control form-control-sm square woodSpecies" placeholder="wood species">
    @foreach (var woodSpecie in woodSpecies)
    {
                                                                <option value="@woodSpecie">@woodSpecie</option>
    }
                                        </select>
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm square" placeholder="Door Style" />
                                    </td>
                                    <td>
                                            <input class="form-control form-control-sm square" placeholder="Finish" />
                                    </td>
                                    <td style="vertical-align:middle;">
                                        <button class=" btn btn-sm btn-danger delete-row"><i class="feather icon-trash" title="Delete Cabinet Details"></i></button>
                                    </td>
                                    </tr>
                                `;

        $("#cabinetDetailsTable tbody").append(newRow);

        //convert newRow to HTML tr element
        var addedRow = $('#cabinetDetailsTable tbody tr:last-child');
        configuringSelectLists(addedRow);
    }

    // Helper function to configure select2
    function configureSelect2(selectList) {
        selectList.select2({
            tags: true,
            placeholder: 'Select or type',
            allowClear: true,                                                                                                                                             
            createTag: function (params) {
                return {
                    id: params.term,
                    text: params.term,
                    newOption: true
                };
            },
            templateResult: function (data) {
                var $result = $("<span></span>");
                $result.text(data.text);
                return $result;
            },
            width: '100%'
        });
        // clearing vendor select for first time
        selectList.val(null).trigger('change');
    }

    function configuringSelectLists(addedRow) {
        //cabinetry vendor configuration
        var cabinetryVendor = addedRow.find('.cabinetryVendor');
        cabinetryVendor.select2({
            placeholder: "Select Cabinetry",
            width: "100%",
            language: {
                "noResults": function () {
                    return "No Vendor Found!";
                }
            },
            escapeMarkup: function (markup) {
                return markup;
            }
        });
        // clearing vendor select for first time
        cabinetryVendor.val(null).trigger('change');

        //sectionName, construction, boxMaterials, and woodSpecies configuration using for loop
        var sectionName = addedRow.find('.sectionName');
        var constructions = addedRow.find('.constructions');
        var boxMaterials = addedRow.find('.boxMaterials');
        var woodSpecies = addedRow.find('.woodSpecies');
        var selectLists = [sectionName, constructions, boxMaterials, woodSpecies];
        for (var i = 0; i < selectLists.length; i++) {
            configureSelect2(selectLists[i]);
        }
    }

    // Remove row when the "Delete Item" button is clicked
    $('#cabinetDetailsTable').on('click', '.delete-row', function () {
        $(this).closest('tr').remove();
    });

    // Attach Cabinet Quote Items
    function attachCabinetQuote() {
        // use sweet alert to get quote id from user and then use ajax request to get cabinet quote items.
        Swal.fire({
            title: 'Enter Cabinet Quote ID',
            input: 'text',
            inputAttributes: {
                autocapitalize: 'off'
            },
            showCancelButton: true,
            confirmButtonText: 'Get Cabite Items',
            showLoaderOnConfirm: true,
            preConfirm: (quoteId) => {
                return $.ajax({
                    type: "GET",
                    url: "/Sales/GetCabinetItems",
                    data: { quoteId: quoteId },
                    success: function (data) {
                        return data;
                    },
                    error: function (xhr, status, error) {
                        Swal.showValidationMessage(
                            `Request failed: ${error}`
                        );
                    }
                });
            },
            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.value.length > 0) {
                var cabinetQuoteItems = result.value;
                // add cabinet quote items to the table
                cabinetQuoteItems.forEach(item => {
                    var newRow = `
                                    <tr>
                                    <td>
                                        <select class="form-control form-control-sm square sectionName" placeholder="section">
    @foreach (var sectionName in sectionsNames)
    {
                                                        <option value="@sectionName">@sectionName</option>
    }
                                        </select>
                                        </td>
                                        <td>
                                        <select class="form-control form-control-sm square cabinetryVendor" placeholder="cabinetry">
    @foreach (var vendor in cabinetryVendors)
    {
                                                        <option value="@vendor.VendorId">@vendor.CompanyName</option>
    }
                                        </select>
                                        </td>
                                        <td>
                                        <select class="form-control form-control-sm square constructions" placeholder="construction">
    @foreach (var construction in constructions)
    {
                                                        <option value="@construction">@construction</option>
    }
                                        </select>
                                        </td>
                                        <td>
                                            <select class="form-control form-control-sm square boxMaterials" placeholder="box materials">
    @foreach (var boxMaterial in boxMaterials)
    {
                                                        <option value="@boxMaterial">@boxMaterial</option>
    }
                                        </select>

                                        </td>
                                        <td>
                                        <select class="form-control form-control-sm square woodSpecies" placeholder="wood species">
    @foreach (var woodSpecie in woodSpecies)
    {
                                                        <option value="@woodSpecie">@woodSpecie</option>
    }
                                        </select>
                                        </td>
                                        <td>
                                        <input class="form-control form-control-sm square" placeholder="Door Style" />
                                        </td>
                                        <td>
                                            <input class="form-control form-control-sm square" placeholder="Finish" />
                                        </td>
                                        <td hidden>
                                        <input class="cabinetQuoteId" />
                                        </td>
                                        <td style="vertical-align:middle;">
                                        <button class=" btn btn-sm btn-danger delete-row"><i class="feather icon-trash" title="Delete Cabinet Details"></i></button>

                                        </td>
                                        </tr>
                                        `;
                    $("#cabinetDetailsTable tbody").append(newRow);
                    //convert newRow to HTML tr element
                    var addedRow = $('#cabinetDetailsTable tbody tr:last-child');
                    configuringSelectLists(addedRow);

                    // set values of cabinet quote items to the added row
                    addedRow.find('.sectionName').val(item.sectionName).trigger('change');
                    addedRow.find('.cabinetryVendor').val(item.vendorIdFk.vendorId).trigger('change');
                    addedRow.find('.constructions').val(item.construction).trigger('change');
                    addedRow.find('.boxMaterials').val(item.boxMaterial).trigger('change');
                    addedRow.find('.woodSpecies').val(item.woodSpecie).trigger('change');
                    addedRow.find('input[placeholder="Door Style"]').val(item.doorStyle);
                    addedRow.find('input[placeholder="Finish"]').val(item.cabinetFinish);
                    addedRow.find('.cabinetQuoteId').val(item.cabinetQuotationId);
                });

                Swal.fire({
                    title: 'Cabinet Quote Items Added',
                    icon: 'success'
                });
            } else {
                Swal.fire({
                    title: 'No Cabinet Quote Items Found',
                    icon: 'error'
                });
            }
        });
    }


    // submit SalesForm form
    $("#SalesForm").submit(function (e) {
        e.preventDefault();
        var sale = {
            CustomerId: $("#CustomerId").val(),
            SalesDate: $("#SalesDate").val(),
            Status: $("#Status").val(),
            TotalSalesOrderAmount: $("#TotalSalesOrderAmount").val(),
            AdvancePaid: $("#AdvancePaid").val(),
            CreatedById: $("#CreatedById").val(),
            ModifiedDate: $("#ModifiedDate").val(),
            // HomeAddress1: $("#HomeAddress1").val(),
            // HomeAddress2: $("#HomeAddress2").val(),
            // HomeCity: $("#HomeCity").val(),
            // HomeCountry: $("#HomeCountry").val(),
            // HomeState: $("#HomeState").val(),
            // HomeZip: $("#HomeZip").val(),
            // ShippingAddress1: $("#ShippingAddress1").val(),
            // ShippingAddress2: $("#ShippingAddress2").val(),
            // ShippingCity: $("#ShippingCity").val(),
            // ShippingCountry: $("#ShippingCountry").val(),
            // ShippingState: $("#ShippingState").val(),
            // ShippingZip: $("#ShippingZip").val()
        };

        var cabinetDetails = [];
        $("#cabinetDetailsTable tbody tr").each(function () {
            var cabinetDetail = {
                SectionName: $(this).find('.sectionName').val(),
                VendorId: $(this).find('.cabinetryVendor').val(),
                Construction: $(this).find('.constructions').val(),
                BoxMaterial: $(this).find('.boxMaterials').val(),
                WoodSpecie: $(this).find('.woodSpecies').val(),
                DoorStyle: $(this).find('input[placeholder="Door Style"]').val(),
                CabinetFinish: $(this).find('input[placeholder="Finish"]').val(),
                CabinetQuotationId: $(this).find('.cabinetQuoteId').val()
            };
            cabinetDetails.push(cabinetDetail);
        });

        var data = {
            saleData: sale,
            cabinetItems: cabinetDetails
        };

        $.ajax({
            type: "POST",
            url: "/Sales/CreateSales",
            data: data,
            success: function (data) {
                Swal.fire({
                    title: 'Sale Created Successfully',
                    icon: 'success'
                }).then((result) => {
                    window.location.href = "/Sales/SalesList";
                });
            },
            error: function (error) {
                Swal.fire({
                    title: 'Error Creating Sale',
                    icon: 'error'
                });
            }
        });
    });
</script>