@model SalesHelper.Models.Sale

<div class="content-overlay"></div>
<div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title mb-0">New Sale</h3>
            <div class="row breadcrumbs-top">
                <div class="breadcrumb-wrapper col-12">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="#">Sales</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a>Create New Sale</a>
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="content-body">
        <form class="form" asp-controller="Sales" asp-action="AddSales" method="post">
            <div class="row match-height">
                <div class="col-md-4">
                    <h4 class="form-section"><i class="fa fa-info-circle"></i> Sales Order Information</h4>
                    <div class="form-group">
                        <label>Sales #</label>
                        <input asp-for="SalesNumber" type="text" class="form-control square" placeholder="Sales #" />
                    </div>
                    <div class="form-group">
                        <label>Customer</label>
                        <input asp-for="Customer" type="text" class="form-control square" placeholder="Customer" />
                    </div>
                    <div class="form-group">
                        <label>Home Phone</label>
                        <input asp-for="HomePhone" type="text" class="form-control square" placeholder="Home Phone" />
                    </div>
                    <div class="form-group">
                        <label>Cell Phone</label>
                        <input asp-for="CellPhone" type="text" class="form-control square" placeholder="Cell Phone" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input asp-for="Email" type="email" class="form-control square" placeholder="Email" />
                    </div>
                    <div class="form-group">
                        <label>Created By</label>
                        <input asp-for="CreatedBy" type="text" class="form-control square" placeholder="Created By" />
                    </div>
                    <div class="form-group">
                        <label>Sales Date</label>
                        <input asp-for="SalesDate" type="date" class="form-control square" />
                    </div>
                </div>

                <div class="col-md-4">
                    <h4 class="form-section"><i class="fa fa-home"></i> Home Address</h4>
                    <div class="form-group">
                        <label>Address 1</label>
                        <input asp-for="HomeAddress.Address1" type="text" class="form-control square" placeholder="Address 1" />
                    </div>
                    <div class="form-group">
                        <label>Address 2</label>
                        <input asp-for="HomeAddress.Address2" type="text" class="form-control square" placeholder="Address 2" />
                    </div>
                    <div class="form-group">
                        <label>City</label>
                        <input asp-for="HomeAddress.City" type="text" class="form-control square" placeholder="City" />
                    </div>
                    <div class="form-group">
                        <label>Country</label>
                        <select asp-for="HomeAddress.Country" id="countrySelect" class="form-control square">
                            <option value="">Select a country</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>State</label>
                        <select asp-for="HomeAddress.State" id="stateSelect" class="form-control square">
                            <option value="">Select a state</option>
                            <!-- Add state options here -->
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Zip</label>
                        <input asp-for="HomeAddress.Zip" type="text" class="form-control square" placeholder="Zip" />
                    </div>
                </div>

                <div class="col-md-4">
                    <h4 class="form-section"><i class="fa fa-truck"></i> Shipping Address</h4>
                    <div class="form-group">
                        <label>Label</label>
                        <input asp-for="ShippingAddress.Label1" type="text" class="form-control square" placeholder="Label" />
                    </div>
                    <div class="form-group">
                        <label>Label</label>
                        <input asp-for="ShippingAddress.Label2" type="text" class="form-control square" placeholder="Label" />
                    </div>
                    <div class="form-group">
                        <label>Label</label>
                        <input asp-for="ShippingAddress.Label3" type="text" class="form-control square" placeholder="Label" />
                    </div>
                    <div class="form-group">
                        <label>Label</label>
                        <input asp-for="ShippingAddress.Label4" type="text" class="form-control square" placeholder="Label" />
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="reset" class="btn btn-warning">
                    <i class="fa fa-times"></i> Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-check-square-o"></i> Save
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#HomePhone, #CellPhone").inputmask({
            mask: '999-999-9999',
            placeholder: '___-___-____'
        });

        $('#stateSelect').select2({
            tags: true,
            placeholder: 'Select or type a state',
            allowClear: true,
            createTag: function (params) {
                return {
                    id: params.term,
                    text: params.term,
                    newOption: true
                };
            },
            templateResult: function (data) {
                var $result = $("<span></span>");
                $result.text(data.text);
                return $result;
            }
        });

        $('#countrySelect').select2({
            placeholder: 'Select a country',
            allowClear: true
        });

        $.ajax({
            url: 'https://restcountries.com/v3.1/all',
            method: 'GET',
            success: function (data) {
                let countries = data.map(country => ({
                    id: country.cca2,
                    text: country.name.common
                }));
                $('#countrySelect').select2({
                    data: countries
                });
                $('#countrySelect').val('US').trigger('change');
            },
            error: function (error) {
                console.error('Error fetching countries:', error);
            }
        });
    });
</script>
