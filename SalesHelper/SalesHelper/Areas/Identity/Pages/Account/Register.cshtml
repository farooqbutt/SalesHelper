@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="content-wrapper">
    <div class="content-header row">
    </div>
    <div class="content-body">
        <section class="row flexbox-container">
            <div class="col-12 d-flex align-items-center justify-content-center">
                <div class="col-lg-4 col-md-8 col-10 box-shadow-2 p-0">
                    <div class="card border-grey border-lighten-3 px-2 py-2 m-0">
                        <div class="card-header border-0">
                            <div class="card-title text-center">
                                <img src="/images/logo/SalesHelperLogo.png" alt="branding logo" width="32" height="27">
                                <img src="/images/logo/SalesHelperTextLogo-Black.png" alt="branding logo" width="130" height="27">
                            </div>
                            <h6 class="card-subtitle line-on-side text-muted text-center font-small-3 pt-2">
                                <span>
                                    Create account with SalesHelper
                                </span>
                            </h6>
                        </div>
                        <div class="card-content">
                            <div class="card-body">
                                <form class="form-horizontal form-simple" id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                    <fieldset class="form-group position-relative has-icon-left mb-1">
                                        <input asp-for="Input.FirstName" autocomplete="username" type="text" class="form-control form-control-lg" placeholder="First Name">
                                        <div class="form-control-position">
                                            <i class="feather icon-user"></i>
                                        </div>
                                    </fieldset>
                                    <fieldset class="form-group position-relative has-icon-left mb-1">
                                        <input style="border-top-left-radius:0;border-top-right-radius:0;" asp-for="Input.LastName" autocomplete="username" type="text" class="form-control form-control-lg" placeholder="Last Name">
                                        <div class="form-control-position">
                                            <i class="feather icon-user"></i>
                                        </div>
                                    </fieldset>
                                    <fieldset>
                                        <div class="input-group input-group-lg position-relative has-icon-left mb-1 bootstrap-touchspin">
                                            <input style="border-top-left-radius:0;border-top-right-radius:0;" type="text" asp-for="Input.SalesHelperUsername" class="form-control form-control-lg" placeholder="Username">
                                            <div class="form-control-position">
                                                <i class="feather icon-user"></i>
                                            </div>
                                            <div class="input-group-append">
                                                <span class="input-group-text">@@saleshelper.com</span>
                                            </div>
                                        </div>
                                    </fieldset>
                                    <fieldset class="form-group position-relative has-icon-left mb-1">
                                        <input style="border-top-left-radius:0;border-top-right-radius:0;" asp-for="Input.Email" autocomplete="username" type="email" class="form-control form-control-lg" placeholder="Your Personal Email Address">
                                        <div class="form-control-position">
                                            <i class="feather icon-mail"></i>
                                        </div>
                                    </fieldset>
                                    <fieldset class="form-group position-relative has-icon-left mb-1">
                                        <input style="border-bottom-left-radius:0;border-bottom-right-radius:0;" asp-for="Input.Password" autocomplete="new-password" type="password" class="form-control form-control-lg" placeholder="Enter Password" required>
                                        <div class="form-control-position">
                                            <i class="fa fa-key"></i>
                                        </div>
                                    </fieldset>
                                    <fieldset class="form-group position-relative has-icon-left mb-3">
                                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" type="password" class="form-control form-control-lg" placeholder="Enter Confirm Password" required>
                                        <div class="form-control-position">
                                            <i class="fa fa-key"></i>
                                        </div>
                                    </fieldset>
                                    <button type="submit" class="btn btn-primary btn-lg btn-block"><i class="feather icon-user-plus"></i> Register</button>
                                </form>
                            </div>
                            <p class="text-center">Already have an account ? <a asp-area="Identity" asp-page="/Account/Login" class="card-link">Login</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>